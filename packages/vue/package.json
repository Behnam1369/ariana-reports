{
  "name": "@ariana-reports/vue",
  "version": "0.1.0",
  "description": "Vue 3 report viewer and report designer for ariana-report.",
  "license": "MIT",
  "author": "Behnam Aghaali",
  "homepage": "https://ariana-reports.netlify.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Behnam1369/ariana-reports.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/Behnam1369/ariana-reports/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "vue",
    "report",
    "reporting",
    "report-designer",
    "report-viewer",
    "pdf",
    "excel",
    "report-generator",
    "banded-report",
    "report-builder",
    "pdf-report",
    "excel-export",
    "rtl",
    "persian",
    "typescript"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "node ../../scripts/check-publish.mjs"
  },
  "dependencies": {
    "@ariana-reports/core": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "vue": "3.5.43"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}

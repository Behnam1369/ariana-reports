{
  "name": "@ariana-report/vue",
  "version": "0.1.0",
  "description": "Vue 3 report viewer and report designer for ariana-report.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "vue",
    "report",
    "reporting",
    "report-designer",
    "report-viewer",
    "pdf",
    "excel"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ariana-report/core": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "vue": "3.5.43"
  }
}
